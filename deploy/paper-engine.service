# /etc/systemd/system/paper-engine.service
# Paper trading engine: one uvicorn worker on 127.0.0.1:8000 (hard-coded in paper_engine).
# Install: sudo cp deploy/paper-engine.service /etc/systemd/system/ && sudo systemctl daemon-reload
[Unit]
Description=Paper trading engine (virtual funds only)
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=paper
Group=paper
WorkingDirectory=/opt/paper-trading-engine
ExecStart=/opt/paper-trading-engine/.venv/bin/python -m paper_engine
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT

# Memory tuning for a 2 GB VPS. glibc arenas multiply per thread; 2 keeps RSS predictable.
Environment=MALLOC_ARENA_MAX=2
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
MemoryHigh=700M
MemoryMax=900M
# Prefer killing other processes (Hermes tooling, shells) before the engine: the engine runs
# stop-loss/take-profit triggers for open positions.
OOMScoreAdjust=-200

# Hardening. The engine only needs to write its data directory.
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/paper-trading-engine/data
ProtectHome=yes
PrivateTmp=yes
# PrivateDevices is left off: the news parser worker (multiprocessing) needs /dev/shm.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
