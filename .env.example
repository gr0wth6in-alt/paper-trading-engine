PAPER_API_TOKEN=replace-with-a-random-token-at-least-32-characters
PAPER_DB_PATH=data/paper-apex.db
PAPER_EXCHANGE=apex
PAPER_SYMBOLS=["BTC/USDT:USDT","ETH/USDT:USDT"]
PAPER_SYMBOL_SELECTION=top_volume
PAPER_TOP_SYMBOLS_COUNT=35
PAPER_MEMES_DIR=memes
PAPER_FEED_ENABLED=true
PAPER_INITIAL_BALANCE=10000
PAPER_DEFAULT_LEVERAGE=10
PAPER_MAX_LEVERAGE=20
PAPER_DEFAULT_ALLOCATION_PCT=0.02
PAPER_TAKER_FEE_RATE=0.0006
PAPER_SLIPPAGE_BPS=2
PAPER_MAINTENANCE_MARGIN_RATE=0.005
PAPER_MAX_QUOTE_AGE_SECONDS=5
PAPER_FEED_IDLE_TIMEOUT_SECONDS=30
PAPER_CORS_ORIGINS=[]
PAPER_NEWS_ENABLED=true
PAPER_NEWS_POLL_SECONDS=300
# Hermes agent (optional). Generate with: python -m paper_engine.configure --agent-token
# Leave unset to disable the agent API. Limits are enforced by the engine, not by Hermes.
# PAPER_AGENT_TOKEN=
PAPER_AGENT_MIN_OPEN_INTERVAL_SECONDS=900
PAPER_AGENT_DAILY_LOSS_PCT=0.03
PAPER_AGENT_MAX_OPEN_POSITIONS=3
PAPER_AGENT_MAX_LEVERAGE=10
PAPER_AGENT_MAX_RISK_PER_TRADE_PCT=0.01
# Optional: replace the built-in RSS sources (https only, 1-20 entries).
# PAPER_NEWS_FEEDS=[{"name":"CoinDesk","url":"https://www.coindesk.com/arc/outboundfeeds/rss/"}]

# Feed disabled means no new fills, not synthetic prices. Hermes is not connected.
# Supported public feeds: apex, okx, binance, bybit. Use a new DB path when switching.
# top_volume ranks active ApeX USDT perpetuals at startup; fixed uses PAPER_SYMBOLS.